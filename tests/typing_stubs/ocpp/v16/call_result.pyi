"""Reply containers at the schema-validated OCPP boundary."""

from typing import Any

class _Reply:
    status: Any
    def __init__(self, **kwargs: Any) -> None: ...

class BootNotification(_Reply): ...
class Heartbeat(_Reply): ...
class Authorize(_Reply): ...
class StartTransaction(_Reply): ...
class StopTransaction(_Reply): ...
class StatusNotification(_Reply): ...
class MeterValues(_Reply): ...
class DataTransfer(_Reply): ...

class GetConfiguration(_Reply):
    configuration_key: list[object] | None
    unknown_key: list[str] | None
