"""Outgoing payload constructor boundary, validated by the OCPP library."""

from dataclasses import dataclass
from typing import Any

class _Payload:
    def __init__(self, **kwargs: Any) -> None: ...

class TriggerMessage(_Payload): ...

@dataclass
class DataTransfer:
    vendor_id: str
    message_id: str | None = None
    data: str | None = None

class GetConfiguration(_Payload): ...
class ChangeConfiguration(_Payload): ...
class RemoteStartTransaction(_Payload): ...
class RemoteStopTransaction(_Payload): ...
class ReserveNow(_Payload): ...
class CancelReservation(_Payload): ...
